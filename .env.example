# ---- MongoDB Atlas ----
# Atlas -> your cluster -> Connect -> Drivers -> copy the string, replace <password>.
# If the password has special characters (@ : / ?) URL-encode them (e.g. @ becomes %40).
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=urban_tandoor

# ---- Embeddings ----
# gemini = real embeddings (free key: https://aistudio.google.com/apikey)
# fake   = offline test embedder (no API, not semantically smart)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=20
EMBED_SLEEP_SECONDS=1.0

# ---- Search ----
# auto   = try Atlas $vectorSearch, fall back to in-Python cosine (works while the index is still building)
# atlas  = Atlas only      python = always in-Python (fine for ~200 documents)
VECTOR_SEARCH_MODE=auto

# Re-embed changed documents in the background after create/update/delete through the API
AUTO_REINDEX=true
