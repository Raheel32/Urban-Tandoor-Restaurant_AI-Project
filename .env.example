# Copy to .env and fill in.
DATABASE_URL=postgresql://tandoor:tandoor@localhost:5432/urban_tandoor

# gemini  -> real embeddings (needs GEMINI_API_KEY, get one free at https://aistudio.google.com/apikey)
# fake    -> offline hashing embedder for testing the pipeline without any API
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match vector(768) in sql/schema.sql
EMBEDDING_DIM=768
EMBED_BATCH_SIZE=20
EMBED_SLEEP_SECONDS=1.0
